{
  "name": "vita-log",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/postbuild-fallback.mjs",
    "build:pages": "VITE_BASE=/vita-log/ npm run build",
    "build:cloudflare": "VITE_STORAGE_MODE=d1 npm run build",
    "preview": "vite preview",
    "sqlite": "tsx server/cli.ts",
    "owner": "tsx server/owner-cli.ts",
    "d1:backup": "node --import tsx server/d1-backup-cli.ts",
    "d1:cutover": "node --import tsx server/d1-cutover-cli.ts",
    "sqlite:server": "npm run build && tsx server/main.ts",
    "verify:release": "npm run build && node scripts/verify-release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
